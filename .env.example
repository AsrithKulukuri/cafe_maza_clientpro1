# Core runtime
PORT=5000
PORT_AUTO_FALLBACK=false
NODE_ENV=development
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000

# Database + auth
MONGODB_URI=mongodb://127.0.0.1:27017/cafe_maza
JWT_SECRET=replace_with_secure_secret_at_least_32_chars

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=mazacafe2@gmail.com

# Payments (required when online payment is enabled)
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# WhatsApp admin alerts (optional)
WHATSAPP_ADMIN_PHONE=

# WhatsApp webhook verification token (required when webhook route is enabled)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

# MSG91 WhatsApp OTP
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_TEMPLATE_NAME=cafe_maza_otp
MSG91_INTEGRATED_NUMBER=replace_with_your_integrated_whatsapp_number
MSG91_OTP_LANGUAGE=en
MSG91_OTP_BUTTON_URL_PARAM=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10

# MSG91 order lifecycle templates
MSG91_ORDER_LANGUAGE=en
MSG91_ORDER_PLACED_TEMPLATE=order_placed
MSG91_ORDER_ACCEPTED_TEMPLATE=order_accepted
MSG91_DELIVERY_ASSIGNED_TEMPLATE=delivery_assigned
MSG91_OUT_FOR_DELIVERY_TEMPLATE=out_for_delivery
MSG91_ORDER_DELIVERED_TEMPLATE=order_deliveredd
# Optional explicit key for double-d naming; takes precedence when set.
MSG91_ORDER_DELIVEREDD_TEMPLATE=order_deliveredd
MSG91_EVENT_DEDUPE_MINUTES=180
MSG91_ORDER_DELIVERED_DEDUPE_MINUTES=1440

# Supabase (used by backend scripts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
